# PostgreSQL connection string (matches docker-compose.dev.yml for local dev)
# Port 5433, not 5432 — this app's dev/prod compose files deliberately avoid
# the default Postgres/MinIO/app ports already in use by other services on
# the same machine. See README's "Ports" section.
DATABASE_URL="postgresql://together_diary:together_diary@localhost:5433/together_diary"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Dev: http://localhost:3300 (see PORT below). Prod: the public domain,
# e.g. https://diary.lmt-nqt.online
NEXTAUTH_URL="http://localhost:3300"

# Port the Next.js app itself listens on (ecosystem.config.js, .claude/launch.json).
PORT=3300

# S3-compatible object storage (SeaweedFS S3 gateway — see docker-compose.dev.yml;
# MinIO's own images require a paid login to pull as of 2026, see ledger Task 1).
# Var names kept as MINIO_* since the app just talks to it over the S3 API.
MINIO_ENDPOINT="http://localhost:9010"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="together-diary"
# Optional: public URL browsers use for <img src> when it differs from
# MINIO_ENDPOINT (e.g. in prod, routed in through the Cloudflare Tunnel's
# media.lmt-nqt.online ingress rule — see deploy/cloudflared-config.yml).
# Unset in dev: defaults to MINIO_ENDPOINT.
# MINIO_PUBLIC_URL="https://media.lmt-nqt.online"

# Only read by docker-compose.prod.yml (Postgres's own password, and part of
# the app container's internal DATABASE_URL). Not used in dev — dev's
# Postgres password is the fixed "together_diary" baked into
# docker-compose.dev.yml. Required when deploying with Docker.
# POSTGRES_PASSWORD="replace-with-a-long-random-string"
