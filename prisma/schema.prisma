generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  entries      DiaryEntry[]
  moods        Mood[]
}

// A user's own mood list: seeded from DEFAULT_MOODS (lib/moods.ts) the first
// time it's read, then freely editable. `group` is one of lib/moods.ts
// MOOD_GROUPS and drives the dashboard's grouping/trend.
model Mood {
  id        String       @id @default(cuid())
  userId    String
  name      String
  icon      String
  group     String
  sortOrder Int          @default(0)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   DiaryEntry[]

  @@unique([userId, name])
  @@index([userId])
}

// Many entries per day. `date` is the user's local calendar day at creation
// (client-supplied "YYYY-MM-DD"); `createdAt` is the exact creation instant.
// title/preview/words are derived from contentJson on every save so the
// sidebar and dashboard never have to parse the document.
model DiaryEntry {
  id              String   @id @default(cuid())
  userId          String
  date            String
  createdAt       DateTime @default(now())
  title           String   @default("")
  preview         String   @default("")
  words           Int      @default(0)
  moodId          String?
  contentJson     Json
  backgroundType  String   @default("color")
  backgroundValue String   @default("#FFF4DE")
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
  mood            Mood?    @relation(fields: [moodId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, date])
}
